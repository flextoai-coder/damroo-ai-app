{
  "expo": {
    "name": "Damroo AI",
    "slug": "damroo-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "damrooai",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBEEE0",
    "primaryColor": "#F97316",
    "extra": {
      "privacyPolicyUrl": "https://damroo.ai/privacy",
      "termsUrl": "https://damroo.ai/terms",
      "supportUrl": "https://damroo.ai/support",
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "05456c83-8f01-44b2-b992-d96bf26ba50b"
      }
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "ai.damroo.app",
      "backgroundColor": "#FBEEE0",
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Damroo AI needs photo access to attach reference images for generation.",
        "NSCameraUsageDescription": "Damroo AI needs camera access to capture reference images for generation.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "package": "ai.damroo.app",
      "backgroundColor": "#FBEEE0",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FBEEE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#FBEEE0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBEEE0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Damroo AI to access Face ID when required."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damroo AI needs photo access to attach reference images for generation.",
          "cameraPermission": "Damroo AI needs camera access to capture reference images for generation."
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Damroo AI saves your generated images to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "damroo-ai-2"
  }
}
