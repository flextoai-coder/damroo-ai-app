# Public (safe for the Expo client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys — from app.revenuecat.com → Project settings → API keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Sentry crash/error reporting — from sentry.io → your project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# Optional — only needed if you switch Google to native @react-native-google-signin
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-only — set as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets).
# NEVER use EXPO_PUBLIC_ for these.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3/images/generations
ARK_MODEL=seedream-4-5-251128
OPENAI_API_KEY=
OPENAI_ENHANCE_MODEL=gpt-4o-mini
OPENAI_CAPTION_MODEL=gpt-4o-mini
OPENAI_AUTO_ENHANCE_MODEL=gpt-4o-mini
# Value you configure as the webhook's "Authorization" header in the
# RevenueCat dashboard (Project settings → Integrations → Webhooks).
REVENUECAT_WEBHOOK_AUTH_HEADER=
CRON_SECRET=

# --- Auth setup (Supabase Dashboard) ---
# 1. Authentication → Providers → enable Email, Google, and Apple
# 2. Email provider: turn Confirm email OFF so users can sign in right after signup
# 3. Authentication → URL Configuration:
#    Site URL: https://thvqecpkurkzcmkdqzki.supabase.co  (https, not a custom scheme)
#    Redirect URLs (add all):
#      damrooai://auth/callback
#      damrooai://**
#      exp://**
# 4. Google Cloud Console: OAuth client; paste Client ID/Secret into Supabase Google provider
# 5. Apple: enable Sign in with Apple for bundle id ai.damroo.app; add App ID to Supabase Apple Client IDs
